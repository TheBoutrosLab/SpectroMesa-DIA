includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"
includeConfig "${projectDir}/config/profiles.config"
params {
    input_csv = '/path/to/mzML.csv'
    decoy_database = '/path/to/target-decoy.fasta'
    decoy_string = 'DECOY_'
    decoy_position = 'prefix'
    contam_string = 'CONTAMINANT_'
    contam_position = 'prefix'
    msfragger_executable = '/path/to/MSFragger.jar'
    output_dir = '/path/to/results'
    dataset_id = 'cohort'
    // proteovault_version = '0.1.0'
    // For an external profile, set compute_profile and additional_resource_profile_dir.
    // compute_profile = 'my_cluster'
    // additional_resource_profile_dir = '/first/profiles:/second/profiles'

    search_ProteomicDIA {
        MSFragger {
            precursor_mass_lower = -25
            precursor_mass_upper = 25
            precursor_true_tolerance = 4
            fragment_mass_tolerance = 50
            isotope_error = '0/1/2'
            output_report_topN = 5
            search_enzyme_name_1 = 'stricttrypsin'
            search_enzyme_cut_1 = 'KR'
            search_enzyme_nocut_1 = ''
            search_enzyme_sense_1 = 'C'
            allowed_missed_cleavage_1 = 2
            num_enzyme_termini = 2
            clip_nTerm_M = 1
            variable_mod_01 = '15.9949 M 3'     // Oxidation of Methionine
            variable_mod_02 = '42.0106 [^ 1'    // Acetylation of Protein N-term
            allow_multiple_variable_mods_on_residue = 0
            max_variable_mods_per_peptide = 3
            digest_min_length = 7
            digest_max_length = 50
            digest_mass_range = '500.0 5000.0'
            max_fragment_charge = 2
            minimum_peaks = 15
            use_topN_peaks = 150
            min_matched_fragments = 4
            add_C_cysteine = 57.02146          // Carbamidomethylation of Cysteine
        }
    }
    validate_ProteomicPSM {
        // Set run_protloom = true and provide a project YAML to use ProtLoom.
        run_protloom = false
        protein_inference_algorithm = 'ProteinProphet'
        protloom_project_yaml = ''
        protloom_pc_order = 'proteotypic'
        protloom_pt_order = 'canonical'
        protloom_enzyme = 'trypsin'
        easypqp_psm_qvalue = 0.01
    }
    generate_ProteomicSpectralLibrary {
        idxml_score_type = 'ProtLoom PEP'
    }
    quantitate_ProteomicDIA {
        'DIA-NN' {
            qvalue = 0.01
            matrix_qvalue = 0.01
            no_ifs_removal = true
            no_prot_inf = true
        }
    }
    qc_ProteomicDIA {
        // pyopenms_version = '3.5.0'
        // docker_image_plotly = 'multiqc/multiqc:v1.35'
    }
}

methods.setup()
