profiles {
    standard {
        params.child_profile = 'standard'
        docker.enabled = true
        apptainer.enabled = false
        singularity.enabled = false
    }
    docker {
        params.child_profile = 'docker'
        docker.enabled = true
        apptainer.enabled = false
        singularity.enabled = false
    }
    apptainer {
        params.child_profile = 'apptainer'
        docker.enabled = false
        apptainer.enabled = true
        singularity.enabled = false
        apptainer.autoMounts = true
        apptainer.ociAutoPull = true
    }
    singularity {
        params.child_profile = 'singularity'
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.ociAutoPull = true
    }
    local {
        params.child_profile = 'local'
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = false
    }
    pines { params.compute_profile = 'pines' }
    boutroslab_aws { params.compute_profile = 'boutroslab_aws' }
}
