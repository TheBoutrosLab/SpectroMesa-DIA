NXF_VER=24.10.6
NXF_SYNTAX_PARSER=v1
TEST_DATA_DIR=/path/to/test/data
# Optional cluster: boutroslab_aws or pines. Unset retains the existing test defaults.
NFT_CLUSTER=boutroslab_aws

# Base directory for test runs. AWS adds $SLURM_JOB_ID; Pines uses this directly.
# If unset, defaults to the launch directory.
NFT_RUN_ROOT=/scratch

# Optional for Apptainer. Use persistent directories accessible from every worker.
# NXF_APPTAINER_CACHEDIR=${HOME}/.cache/nextflow/apptainer
# APPTAINER_CACHEDIR=${HOME}/.apptainer/cache
