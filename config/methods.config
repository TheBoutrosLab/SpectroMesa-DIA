
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/methods/common_methods.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/schema/schema.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/bam/bam_parser.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/store_object_as_json/store_object_as_json.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/resource_handler/resource_handler.config"

methods {
    validate_inputs = {
        ['input_csv', 'decoy_database', 'msfragger_executable', 'output_dir'].each { name ->
            if (!params[name]) {
                throw new IllegalArgumentException("Required parameter --${name} is missing")
            }
        }
        ['input_csv', 'decoy_database', 'msfragger_executable'].each { name ->
            def input = new File(params[name].toString())
            if (!input.isFile()) {
                throw new IllegalArgumentException("--${name} must point to an existing file: ${input}")
            }
        }
    }

    apply_compute_profile = {
        params.child_processes_without_memory = [:]
        if (!params.compute_profile) return
        def profileName = params.compute_profile.toString()
        if (!(profileName ==~ /[A-Za-z0-9_]+/)) {
            throw new IllegalArgumentException("Unknown compute profile: ${params.compute_profile}")
        }
        def searchDirs = []
        if (params.additional_resource_profile_dir) {
            params.additional_resource_profile_dir.toString()
                .split(java.util.regex.Pattern.quote(File.pathSeparator))
                .findAll { it?.trim() }
                .each { entry ->
                    def directory = new File(entry)
                    searchDirs << (directory.isAbsolute() ? directory :
                        new File(launchDir.toString(), entry)).canonicalFile
                }
        }
        searchDirs << new File("${projectDir}/config/resource_profiles")
        def profileFile = searchDirs.collect { directory ->
            new File(directory, "${profileName}.json")
        }.find { candidate -> candidate.isFile() }
        if (!profileFile) {
            throw new IllegalArgumentException("Unknown compute profile: ${profileName}; searched ${searchDirs}")
        }
        def profile = new groovy.json.JsonSlurper().parse(profileFile)
        if (!(profile instanceof Map) || !(profile.max_cpus instanceof Number) ||
            profile.max_cpus < 1 || !(profile.max_memory?.toString() ==~ /(?i)^\d+(?:\.\d+)?\s*GB$/) ||
            !(profile.children instanceof Map)) {
            throw new IllegalArgumentException("Invalid resource profile: ${profileFile}")
        }
        params.max_cpus = profile.max_cpus
        params.max_memory = profile.max_memory
        def childDirectories = [
            search_ProteomicDIA: 'search-ProteomicDIA',
            validate_ProteomicPSM: 'validate-ProteomicPSM',
            generate_ProteomicSpectralLibrary: 'generate-ProteomicSpectralLibrary',
            quantitate_ProteomicDIA: 'quantitate-ProteomicDIA'
        ]
        def gigabytes = { value ->
            def match = (value.toString() =~ /(?i)^(\d+(?:\.\d+)?)\s*GB$/)
            if (!match.matches()) {
                throw new IllegalArgumentException("Resource memory must be expressed in GB: ${value}")
            }
            new BigDecimal(match[0][1])
        }
        childDirectories.each { name, directory ->
            params[name].max_cpus = profile.max_cpus
            params[name].max_memory = profile.max_memory
            def requested = profile.children[name]
            def defaults = new groovy.json.JsonSlurper().parse(
                new File("${projectDir}/external/${directory}/config/resources.json")
            ).default
            if (!(requested instanceof Map) || requested.keySet() != defaults.keySet()) {
                throw new IllegalArgumentException("Compute profile ${params.compute_profile} must define every process in ${directory}")
            }
            params.child_processes_without_memory[name] = requested.findAll { processName, allocation ->
                allocation instanceof Map && !allocation.containsKey('memory')
            }.keySet().toList()
            if (name == 'search_ProteomicDIA' &&
                'search_database_MSFragger' in params.child_processes_without_memory[name]) {
                throw new IllegalArgumentException(
                    'search_database_MSFragger requires memory because it sizes its Java heap from task.memory'
                )
            }
            requested.each { processName, allocation ->
                if (!(allocation instanceof Map) || !allocation.containsKey('cpus') ||
                    !(allocation.cpus instanceof Number)) {
                    throw new IllegalArgumentException("Compute profile ${params.compute_profile} requires numeric cpus for ${directory}:${processName}")
                }
            }
            if (!params[name].base_resource_update) {
                def updates = [cpus: [], memory: []]
                defaults.each { processName, allocation ->
                    def target = requested[processName]
                    def cpuSpec = allocation.cpus
                    def baseCpus = Math.max(cpuSpec.min as int,
                        Math.min(cpuSpec.max as int, (int)(profile.max_cpus * cpuSpec.fraction)))
                    def memorySpec = allocation.memory
                    def baseMemory = [gigabytes(memorySpec.min),
                        [gigabytes(memorySpec.max), gigabytes(profile.max_memory) * memorySpec.fraction].min()].max()
                    def targetCpus = target.cpus as int
                    def targetMemory = target.containsKey('memory') ? gigabytes(target.memory) : null
                    if (targetCpus < 1 || targetCpus > profile.max_cpus ||
                        (targetMemory != null && (targetMemory <= 0 || targetMemory > gigabytes(profile.max_memory)))) {
                        throw new IllegalArgumentException("Invalid ${params.compute_profile} resources for ${directory}:${processName}")
                    }
                    if (targetCpus != baseCpus) {
                        def factor = targetCpus / baseCpus
                        updates.cpus << [processName, factor == factor.intValue() ? factor.intValue() : factor]
                    }
                    if (targetMemory != null && targetMemory != baseMemory) {
                        updates.memory << [processName, targetMemory / baseMemory]
                    }
                }
                params[name].base_resource_update = updates.findAll { resource, entries -> entries }
            }
        }
    }

    set_shared_child_params = {
        ['decoy_string', 'contam_string'].each { name ->
            if (!params[name]?.toString()?.trim()) {
                throw new IllegalArgumentException("--${name} must be nonempty")
            }
        }
        ['decoy_position', 'contam_position'].each { name ->
            if (!(params[name] in ['prefix', 'suffix'])) {
                throw new IllegalArgumentException("--${name} must be prefix or suffix")
            }
        }
        if (params.decoy_position != 'prefix') {
            throw new IllegalArgumentException('search-ProteomicDIA requires prefix decoys')
        }

        params.search_ProteomicDIA.decoy_database = params.decoy_database
        params.search_ProteomicDIA.decoy_prefix = params.decoy_string
        params.validate_ProteomicPSM.decoy_database = params.decoy_database
        params.validate_ProteomicPSM.decoy_string = params.decoy_string
        params.validate_ProteomicPSM.decoy_string_position = params.decoy_position

        // ProtLoom takes all four markers from its project YAML. Keep that
        // independent input consistent with the shared metapipeline settings.
        def projectPath = params.validate_ProteomicPSM.get('protloom_project_yaml')
        if (params.validate_ProteomicPSM.run_protloom && !projectPath?.toString()?.trim()) {
            throw new IllegalArgumentException('protloom_project_yaml is required when run_protloom = true')
        }
        if (params.validate_ProteomicPSM.run_protloom) {
            def projectFile = new File(projectPath.toString()).canonicalFile
            if (!projectFile.isFile()) {
                throw new IllegalArgumentException("ProtLoom project YAML does not exist: ${projectFile}")
            }
            params.validate_ProteomicPSM.protloom_project_yaml = projectFile.toString()
            def project = new org.yaml.snakeyaml.Yaml().load(projectFile.text)
            if (!(project instanceof Map) || !(project.database instanceof Map)) {
                throw new IllegalArgumentException('ProtLoom project YAML requires a database section')
            }
            def markers = [
                decoy_string: project.database.decoy_string ?: 'DECOY_',
                decoy_position: project.database.decoy_position ?: 'prefix',
                contam_string: project.database.contam_string ?: 'CONTAMINANT_',
                contam_position: project.database.contam_position ?: 'prefix'
            ]
            markers.each { name, value ->
                if (params[name] != value) {
                    throw new IllegalArgumentException("--${name} must match database.${name} in the ProtLoom project YAML (${value})")
                }
            }
        }
    }

    get_ids_from_bams = {
        params.samples_to_process = [] as Set
        params.input.BAM.each { k, v ->
            v.each { sample ->
                // FIXME This is a hack to find files within this repository.
                // Remove this line when building out a real pipeline.
                if (sample.path.startsWith("./")) { sample.path = "${projectDir}/${sample.path}" }

                def bam_header = bam_parser.parse_bam_header(sample.path)
                def sm_tags = bam_header['read_group'].collect{ it['SM'] }.unique()
                if (sm_tags.size() != 1) {
                    throw new Exception("${bam_path} contains multiple samples! Please run pipeline with single sample BAMs.")
                }
                if (params.samples_to_process.any { it.id == sm_tags[0] }) {
                    throw new Exception("Sample ${sm_tags[0]} was found in multiple BAMs. Please provide only one BAM per sample")
                }

                params.samples_to_process.add(['id': sm_tags[0], 'path': sample.path, 'sample_type': k])
            }
        }
    }

    set_output_and_log_dir = {
        params.output_dir_base = "${params.output_dir}/${manifest.name}-${manifest.version}/${params.dataset_id}"

        def tz = TimeZone.getTimeZone("UTC")
        def date = new Date().format("yyyyMMdd'T'HHmmss'Z'", tz)

        params.log_output_dir = "${params.output_dir_base}/log-${manifest.name}-${manifest.version}-${date}"
        params.final_output_dir = "${params.output_dir_base}/main_workflow"
    }

    set_pipeline_logs = {
        trace.enabled = true
        trace.file = "${params.log_output_dir}/nextflow-log/trace.txt"

        timeline.enabled = true
        timeline.file = "${params.log_output_dir}/nextflow-log/timeline.html"

        report.enabled = true
        report.file = "${params.log_output_dir}/nextflow-log/report.html"
    }

    setup = {
        methods.validate_inputs()

        methods.apply_compute_profile()

        if (!params.validate_ProteomicPSM.run_protloom) {
            params.generate_ProteomicSpectralLibrary.idxml_score_type = 'Posterior Error Probability'
        }

        methods.set_shared_child_params()

        schema.load_custom_types("${projectDir}/config/custom_schema_types.config")
        schema.validate()

        resource_handler.handle_resources("${projectDir}/config/resources.json")

        methods.set_output_and_log_dir()
        methods.set_pipeline_logs()

        methods.set_env()

        methods.configure_containerization()

        methods.setup_process_afterscript()

        // Save all parameters in log directory. This call must be the last configuration setup step.
        json_extractor.store_object_as_json(
            params,
            new File("${params.log_output_dir}/nextflow-log/params.json")
        )
    }
}
