// reconstruct-ProteomicMSMS v1.0.1 does not define a singularity profile.
// Supply the metapipeline's matching runtime profile to this child.
profiles {
    singularity {
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.ociAutoPull = true
        params.container_mount_flag = '-B'
    }
}
