includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"
includeConfig "${projectDir}/config/profiles.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    input_csv = "${projectDir}/test/test_integration_diaTracer_MSFragger_ProteinProphet_DIANN/input.csv"
    decoy_database = "${TEST_DATA_DIR}/hela_diapasef/database/UP000005640_9606-SwissProt-FragPipe/2026-11-03-decoys-contam-input.fasta.fas"
    decoy_string = 'DECOY_'
    decoy_position = 'prefix'
    contam_string = 'contam_'
    contam_position = 'prefix'
    msfragger_executable = "${TEST_DATA_DIR}/MSFragger-4.4.1.jar"
    diatracer_executable = "${TEST_DATA_DIR}/diaTracer-2.2.1.jar"
    bruker_lib_dir = "${TEST_DATA_DIR}/MSFragger-4.4.1/ext/bruker"
    dataset_id = 'hela_diapasef'
    compute_profile = System.getenv('NFT_CLUSTER') == 'pines' ? 'pines' : 'boutroslab_aws'

    search_ProteomicDIA {
        MSFragger {
            precursor_mass_lower = -20
            precursor_mass_upper = 20
            precursor_true_tolerance = 10
            fragment_mass_tolerance = 20
            isotope_error = '0/1/2'
            output_report_topN = 5
        }
    }
    validate_ProteomicPSM {
        run_protloom = false
        protein_inference_algorithm = 'ProteinProphet'
        enzyme = 'Trypsin/P'
        easypqp_psm_qvalue = 0.01
    }
    quantitate_ProteomicDIA {
        copy_inputs_to_work = true
    }
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(
    params.input_csv, 'test_integration_diaTracer_MSFragger_ProteinProphet_DIANN', launchDir
)

methods.setup()
