includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"
includeConfig "${projectDir}/config/profiles.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    input_csv = "${projectDir}/test/test_integration_MSFragger_ProteinProphet_DIANN_multifraction/input.csv"
    decoy_database = "${TEST_DATA_DIR}/database/2026-01-12-decoys-Escherichia_coli_str_k_12_substr_mg1655_gca_000005845.ASM584v2.pep.all_contam.fa.fas"
    decoy_string = 'rev_'
    decoy_position = 'prefix'
    contam_string = 'contam_'
    contam_position = 'prefix'
    msfragger_executable = "${TEST_DATA_DIR}/MSFragger-4.4.1.jar"
    dataset_id = 'ECOLI_DIA_FRACTIONATED'
    compute_profile = System.getenv('NFT_CLUSTER') == 'pines' ? 'pines' : 'boutroslab_aws'

    search_ProteomicDIA {
        MSFragger {
            precursor_mass_lower = -25
            precursor_mass_upper = 25
            precursor_true_tolerance = 4
            fragment_mass_tolerance = 50
            isotope_error = '0/1/2'
            output_report_topN = 5
            search_enzyme_name_1 = 'stricttrypsin'
            search_enzyme_cut_1 = 'KR'
            search_enzyme_nocut_1 = ''
            search_enzyme_sense_1 = 'C'
            allowed_missed_cleavage_1 = 2
            num_enzyme_termini = 2
            clip_nTerm_M = 1
            variable_mod_01 = '15.9949 M 3'
            variable_mod_02 = '42.0106 [^ 1'
            allow_multiple_variable_mods_on_residue = 0
            max_variable_mods_per_peptide = 3
            digest_min_length = 7
            digest_max_length = 50
            digest_mass_range = '500.0 5000.0'
            max_fragment_charge = 2
            minimum_peaks = 15
            use_topN_peaks = 150
            min_matched_fragments = 4
            add_C_cysteine = 57.02146
        }
    }
    validate_ProteomicPSM {
        run_protloom = false
        proteinprophet_min_probability = 0.0
        easypqp_psm_qvalue = 0.01
    }
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(
    params.input_csv, 'test_integration_MSFragger_ProteinProphet_DIANN_multifraction', launchDir
)

methods.setup()
