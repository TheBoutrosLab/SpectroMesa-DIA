params {
    input_csv = null
    decoy_database = null
    decoy_string = 'DECOY_'
    decoy_position = 'prefix'
    contam_string = 'CONTAMINANT_'
    contam_position = 'prefix'
    msfragger_executable = null
    reconstruct_nextflow_version = '25.10.5'
    diatracer_executable = ''
    bruker_lib_dir = ''
    reconstruct_ProteomicMSMS {
        diatracer_write_inter = 0
    }
    output_dir = null
    dataset_id = 'cohort'
    child_profile = 'standard'
    proteovault_version = '0.1.0'
    docker_image_proteovault = "ghcr.io/theboutroslab/proteovault:${params.proteovault_version}"
    compute_profile = ''
    additional_resource_profile_dir = ''
    ucla_cds = false
    search_ProteomicDIA {
        MSFragger {
            precursor_mass_lower = -25
            precursor_mass_upper = 25
            precursor_true_tolerance = 4
            fragment_mass_tolerance = 50
            isotope_error = '0/1/2'
            allowed_missed_cleavage_1 = 2
            output_report_topN = 5
            use_topN_peaks = 1000
        }
    }
    validate_ProteomicPSM {
        protloom_project_yaml = ''
        protloom_version = '0.3.1'
        index_peptides_unmatched_action = 'remove'
        index_peptides_aaa_max = 0
        run_percolator = true
        percolator_workflow = 'msbooster'
        run_protloom = false
        protein_inference_algorithm = 'ProteinProphet'
        export_easypqp_reports = true
        merge_consensus = false
        fractionated = false
        protloom_idxml_primary_score = 'pep'
        easypqp_psm_qvalue = 0.01
        protloom_easypqp_group_qvalue = 0.01
    }
    generate_ProteomicSpectralLibrary {
        fractionated = false
        idxml_score_type = 'ProtLoom PEP'
        easypqp_score_type = 'PEP'
    }
    quantitate_ProteomicDIA {
        'DIA-NN' {
            qvalue = 0.01
            matrix_qvalue = 0.01
            verbose = 1
            matrices = true
            smart_profiling = true
            no_quant_files = true
            peak_center = true
            no_ifs_removal = true
            report_lib_info = true
            no_prot_inf = true
        }
    }
    qc_ProteomicDIA {
        docker_image_plotly = 'multiqc/multiqc:v1.35'
    }
}
process.executor = 'local'

// Only the ProteoVault parent process declares a container. Runtime profiles
// select its engine and pass the matching child_profile to child pipelines.
docker.enabled = true
docker.runOptions = "-u \$(id -u):\$(id -g) \$(for i in \$(id -G); do echo -n \"--group-add=\$i \"; done)"
apptainer.enabled = false
singularity.enabled = false
